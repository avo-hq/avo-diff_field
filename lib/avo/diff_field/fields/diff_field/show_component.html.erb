<style>
  .diff{overflow:auto;}
  .diff ul{overflow:auto;list-style:none;margin:0;padding:0;display:table;width:100%;}
  .diff del, .diff ins{display:block;text-decoration:none;}
  .diff li{padding:0; display:table-row;margin: 0;height:1em;}
  .diff li.ins{background:color-mix(in oklab, var(--color-success) 15%, var(--color-primary));}
  .diff li.del{background:color-mix(in oklab, var(--color-danger) 15%, var(--color-primary));}
  /* try 'whitespace:pre;' if you don't want lines to wrap */
  .diff del, .diff ins, .diff span{white-space:pre-wrap;font-family:var(--font-mono);}
  .diff del strong{font-weight:normal;background:color-mix(in oklab, var(--color-danger) 40%, var(--color-primary));}
  .diff ins strong{font-weight:normal;background:color-mix(in oklab, var(--color-success) 40%, var(--color-primary));}
  .diff li.diff-comment { display: none; }
  .diff li.diff-block-info { background: var(--color-secondary); color: var(--color-content-secondary); }
</style>

<%= field_wrapper **field_wrapper_args do %>
  <% resource_keys = @field.value.keys %>
  <div class="space-y-2">
    <% @diffy_value.each do |value| %>
      <div class="border border-tertiary rounded p-2">
        <div class="uppercase font-bold text-content-secondary text-xs"><%= value[0] %></div>
        <div class="pt-2 pb-2"><%= value[1].to_s(:html).html_safe %></div>
      </div>
    <% end %>
  </div>
<% end %>